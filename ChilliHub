-- ===== KEY SYSTEM =====
local correctKey = "Null2030"
local keyFile    = "chillihub_key.txt"
local scriptURL  = "https://raw.githubusercontent.com/apiluarmor-hub/ChilliHub/refs/heads/main/ChilliHubV4"
local discordURL = "https://discord.gg/TBQpdptYqH"

local function runScript()
    loadstring(game:HttpGet(scriptURL))()
end

local function hasSavedKey()
    if isfile and isfile(keyFile) then
        return readfile(keyFile) == correctKey
    end
    return false
end

local function saveKey(k)
    if writefile then writefile(keyFile, k) end
end

-- Si ya hay key guardada, ejecuta directo
if hasSavedKey() then
    runScript()
    return
end

