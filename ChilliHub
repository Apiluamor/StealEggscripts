-- Copiar enlace al portapapeles al tocar el botón de Discord
DiscordBtn.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(discordURL)
        CopyStatus.TextColor3 = Color3.fromRGB(90, 255, 130)
        CopyStatus.Text = "✅ Enlace copiado / Link copied!"
    else
        CopyStatus.TextColor3 = Color3.fromRGB(255, 200, 90)
        CopyStatus.Text = "Copia manualmente: " .. discordURL
    end
    task.wait(2)
    CopyStatus.Text = ""
end)

Button.MouseButton1Click:Connect(function()
    if TextBox.Text == correctKey then
        Status.TextColor3 = Color3.fromRGB(90, 255, 130)
        Status.Text = "✅ ¡Key correcta! Cargando script..."
        saveKey(TextBox.Text)
        task.wait(0.8)
        ScreenGui:Destroy()
        runScript()
    else
        Status.TextColor3 = Color3.fromRGB(255, 80, 80)
        Status.Text = "❌ Key incorrecta. Intenta de nuevo."
        TextBox.Text = ""
    end
end)
